{
  "name": "moiflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "MoiFlow monorepo — React Native mobile app (Moi + Finance), FastAPI backend, and web admin portal.",
  "workspaces": [
    "apps/mobile",
    "apps/admin-portal",
    "shared"
  ],
  "scripts": {
    "mobile": "npm --workspace apps/mobile run start",
    "mobile:android": "npm --workspace apps/mobile run android",
    "mobile:ios": "npm --workspace apps/mobile run ios",
    "mobile:test": "npm --workspace apps/mobile run test",
    "admin": "npm --workspace apps/admin-portal run dev",
    "admin:build": "npm --workspace apps/admin-portal run build",
    "backend": "python -m uvicorn app.main:app --reload --app-dir apps/api-backend"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
