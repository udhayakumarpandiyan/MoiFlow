# ---------------------------------------------------------------------------
# MoiFlow AI Backend — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:1701@localhost:5432/moiflow

# --- JWT / Session ---
JWT_SECRET_KEY=your-super-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP Configuration ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_SEND_PER_HOUR=5

# --- OTP Store Backend ---
# Options: "memory" (dev/single-instance) | "redis" (production)
OTP_STORE_BACKEND=memory

# --- Redis (required when OTP_STORE_BACKEND=redis) ---
REDIS_URL=redis://localhost:6379/0

# --- SMS Provider ---
# Options: "console" (dev) | "twofactor" | "twilio" | "msg91"
SMS_PROVIDER=console

# --- 2Factor (required when SMS_PROVIDER=twofactor) ---
# Backend-only secret. NEVER expose to the mobile app.
TWOFACTOR_API_KEY=
# Optional named template/sender registered in the 2Factor dashboard.
TWOFACTOR_TEMPLATE_NAME=
TWOFACTOR_SENDER_ID=

# --- Twilio (required when SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 (required when SMS_PROVIDER=msg91) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# --- RevenueCat (subscriptions) ---
# Shared secret configured as the webhook Authorization header in the
# RevenueCat dashboard. Required in production. Backend-only.
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Optional REST API key for reconciliation / fetching subscriber info.
REVENUECAT_API_KEY=

# --- Sarvam AI ---
# AI_PROVIDER: "sarvam" | "none" (none disables AI, useful for local dev).
AI_PROVIDER=sarvam
# Backend-only secret. NEVER expose to the mobile app.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-m

# --- Admin ---
# Bootstrap admin seeded on first run if provided (see admin module).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Comma-separated list of allowed origins (mobile app + admin portal).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- OCR engines (handwritten notebook scanning) ---
# Engine order for /api/ocr/handwritten-entries:
#   Google Vision -> EasyOCR (offline) -> Tesseract (offline).
# NOTE: easyocr<=1.7.2 has a broken Tamil recognizer and degrades to English
# only (reads amounts + English initials, not Tamil script). Set the Vision
# key below for accurate handwritten Tamil.

# Google Cloud Vision API key (best accuracy for handwritten Tamil).
# Enable "Cloud Vision API" in Google Cloud Console and create an API key.
# Leave blank to rely on the offline engines only.
GOOGLE_VISION_API_KEY=

# Disable EasyOCR on low-memory hosts (set to 0):
# EASYOCR_ENABLED=1

# Tesseract offline fallback — requires the Tesseract binary + Tamil pack.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSDATA_PREFIX=C:\Program Files\Tesseract-OCR\tessdata
