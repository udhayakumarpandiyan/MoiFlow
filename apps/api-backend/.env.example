# ============================================================================
# MoiFlow Backend — PRODUCTION environment template
# ============================================================================
# Copy to `.env` (local) or provide these as real environment variables on your
# host (Render / AWS / Azure / Fly / etc.). In production the app reads process
# env directly; the .env file is only auto-loaded when ENVIRONMENT != production.
#
# RULES
#   - NEVER commit the filled-in .env. Only this .example belongs in git.
#   - Every value marked REQUIRED must be set in production or the app refuses
#     to boot (see validate_production_config() in app/core/config.py).
#   - All keys here are BACKEND-ONLY secrets. None of them may be shipped to the
#     mobile app or the browser admin portal.
#   - Rotate any secret that has ever been committed or shared.
# ============================================================================


# ---------------------------------------------------------------------------
# Environment  (REQUIRED)
# ---------------------------------------------------------------------------
# Setting this to "production" enables strict validation and disables .env
# auto-loading, memory OTP store, and the console SMS provider.
ENVIRONMENT=production

# Optional metadata (safe defaults if omitted).
APP_NAME=MoiFlow
APP_VERSION=1.0.0


# ---------------------------------------------------------------------------
# Database — PostgreSQL  (REQUIRED)
# ---------------------------------------------------------------------------
# Must use the asyncpg driver. Use a managed Postgres with TLS in production.
# URL-encode special characters in the password (@ -> %40, # -> %23, etc.).
# Example: postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME?ssl=require
DATABASE_URL=postgresql://postgres:HJACUASkaADAcGsShHFuxrXPyOlwfIsU@postgres.railway.internal:5432/railway


# ---------------------------------------------------------------------------
# JWT / Session  (REQUIRED)
# ---------------------------------------------------------------------------
# Must be a strong, random value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app rejects the known dev placeholders and any key shorter than 32 chars.
JWT_SECRET_KEY=h5znQcV19lnSQ8V3XAfTDc-HDfSO44nMCX7iCiPrYpRcKKlrnas-8eb25Hd182fXw_SYW4eA96t1mmiDG2ob0A
JWT_ALGORITHM=HS256
# Mobile access-token lifetime (minutes). 1440 = 24h.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=60


# ---------------------------------------------------------------------------
# OTP
# ---------------------------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Per-phone hourly send cap (rate limiting / abuse protection).
OTP_MAX_SEND_PER_HOUR=5


# ---------------------------------------------------------------------------
# OTP Store  (REQUIRED in production: must be redis)
# ---------------------------------------------------------------------------
# "memory" only works for local single-instance dev. Production runs multiple
# workers/instances, so a shared Redis store is mandatory.
OTP_STORE_BACKEND=redis


# ---------------------------------------------------------------------------
# Redis  (REQUIRED when OTP_STORE_BACKEND=redis)
# ---------------------------------------------------------------------------
# Prefer a TLS endpoint (rediss://) with an auth password in production.
# Example: rediss://default:PASSWORD@REDIS_HOST:6379/0
REDIS_URL=redis://default:srxpsepNaNMQxWAhKGIYtOAGrkMFeiqB@redis.railway.internal:6379


# ---------------------------------------------------------------------------
# SMS Provider  (REQUIRED: cannot be "console" in production)
# ---------------------------------------------------------------------------
# Options: "twofactor" | "twilio" | "msg91"   ("console" is dev-only)
SMS_PROVIDER=twofactor

# --- 2Factor (REQUIRED when SMS_PROVIDER=twofactor) — https://2factor.in ---
# Backend-only API key. Never expose to the mobile app.
TWOFACTOR_API_KEY=7917ef0a-b18b-11f1-90d7-0200cd936042
# Optional named template/sender registered in the 2Factor dashboard.
TWOFACTOR_TEMPLATE_NAME=MoiFlowOTP
TWOFACTOR_SENDER_ID=MFLOW

# --- Twilio (REQUIRED only when SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 (REQUIRED only when SMS_PROVIDER=msg91) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=


# ---------------------------------------------------------------------------
# RevenueCat — subscriptions  (WEBHOOK TOKEN REQUIRED in production)
# ---------------------------------------------------------------------------
# Shared secret set as the webhook Authorization header value in the RevenueCat
# dashboard; used to authenticate incoming webhooks. Backend-only.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
REVENUECAT_WEBHOOK_AUTH_TOKEN=
# Optional REST API key for reconciliation / fetching subscriber info.
REVENUECAT_API_KEY=


# ---------------------------------------------------------------------------
# Sarvam AI  (SARVAM_API_KEY REQUIRED when AI_PROVIDER=sarvam)
# ---------------------------------------------------------------------------
# AI_PROVIDER: "sarvam" | "none" ("none" disables AI features entirely).
AI_PROVIDER=sarvam
# Backend-only secret. Never expose to the mobile app.
SARVAM_API_KEY=sk_k9apmlvk_Mtp22OBkj2VW6mm0ebqcj3ab
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_CHAT_MODEL=sarvam-m


# ---------------------------------------------------------------------------
# Admin bootstrap
# ---------------------------------------------------------------------------
# Seeds a single superadmin on first startup if BOTH are set (idempotent — it
# never overwrites an existing account). Set them for the initial deploy, then
# create further admins from the portal and clear/rotate this password.
# Use a strong password (>= 12 chars, mixed classes).
ADMIN_BOOTSTRAP_EMAIL=admin@moiflow.in
ADMIN_BOOTSTRAP_PASSWORD=MFlowAdmin@2026
# Admin session lifetime (minutes). 480 = 8h.
ADMIN_ACCESS_TOKEN_EXPIRE_MINUTES=480


# ---------------------------------------------------------------------------
# CORS  (REQUIRED: lock to your real origins)
# ---------------------------------------------------------------------------
# Comma-separated allowed origins. Do NOT use "*" and do NOT include localhost
# in production. List only the admin portal origin(s); the mobile app is native
# and does not need a CORS entry.
CORS_ALLOWED_ORIGINS= https://admin.moiflow.in


# ---------------------------------------------------------------------------
# OCR engines (handwritten notebook scanning) — optional
# ---------------------------------------------------------------------------
# Engine order for /api/ocr/handwritten-entries:
#   Google Vision -> EasyOCR (offline) -> Tesseract (offline).
# For accurate handwritten Tamil in production, set the Google Vision key;
# the offline engines do not read Tamil script reliably.

# Google Cloud Vision API key (best accuracy for handwritten Tamil).
GOOGLE_VISION_API_KEY=

# Disable EasyOCR on low-memory hosts (set to 0 to skip loading it).
# EASYOCR_ENABLED=1

# Tesseract offline fallback — requires the Tesseract binary + Tamil pack
# installed on the host. Use the host's real paths.
# TESSERACT_CMD=/usr/bin/tesseract
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
