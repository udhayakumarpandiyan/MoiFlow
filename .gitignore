# ============================================================================
# MoiFlow monorepo .gitignore
# ============================================================================

# --- Node / JS (mobile + admin-portal) -------------------------------------
node_modules/
npm-debug.log
yarn-error.log
*.jsbundle
.metro-health-check*
/coverage
apps/*/coverage/

# Admin portal build output
apps/admin-portal/dist/
apps/admin-portal/.vite/

# --- OSX --------------------------------------------------------------------
.DS_Store

# --- Xcode / iOS ------------------------------------------------------------
build/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata
*.xccheckout
*.moved-aside
DerivedData
*.hmap
*.ipa
*.xcuserstate
**/.xcode.env.local
**/Pods/
/vendor/bundle/

# --- Android / IntelliJ -----------------------------------------------------
.idea
.gradle
local.properties
*.iml
*.hprof
.cxx/
*.keystore
!debug.keystore
.kotlin/
apps/mobile/android/app/release-signing.properties
apps/mobile/android/app/*.keystore
!apps/mobile/android/app/debug.keystore

# --- Environment variables --------------------------------------------------
.env
.env.local
.env.production
apps/api-backend/.env
apps/admin-portal/.env
apps/admin-portal/.env.local

# --- Python (api-backend) ---------------------------------------------------
apps/api-backend/.venv/
apps/api-backend/__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- fastlane ---------------------------------------------------------------
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# --- Yarn -------------------------------------------------------------------
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/sdks
!.yarn/versions
