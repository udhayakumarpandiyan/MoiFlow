# ---------------------------------------------------------------------------
# MoiFlow AI Backend — Environment Configuration
# ---------------------------------------------------------------------------
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ---------------------------------------------------------------------------

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/moiflow

# --- JWT / Session ---
JWT_SECRET_KEY=your-super-secret-key-change-me
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP Configuration ---
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_SEND_PER_HOUR=5

# --- OTP Store Backend ---
# Options: "memory" (dev/single-instance) | "redis" (production)
OTP_STORE_BACKEND=memory

# --- Redis (required when OTP_STORE_BACKEND=redis) ---
REDIS_URL=redis://localhost:6379/0

# --- SMS Provider ---
# Options: "console" (dev) | "twilio" | "msg91"
SMS_PROVIDER=console

# --- Twilio (required when SMS_PROVIDER=twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- MSG91 (required when SMS_PROVIDER=msg91) ---
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
